node_modules
**/node_modules
**/dist
.git
.gitignore
.ai
.idea
.vscode
# No secret reaches the image. The glob also covers .env.local and friends,
# which is why .env.example is matched here too: nothing in the image reads it.
.env*
# Tests never enter the image: the build stage only needs sources and configs.
**/*.test.ts
# Not read by the image build: HOSTING.md and both changelogs are for readers.
HOSTING.md
**/CHANGELOG.md
bitbucket-pipelines.yml
slscan.*
scripts
