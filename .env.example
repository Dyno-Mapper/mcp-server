# ---------------------------------------------------------------------------
# stdio server (packages/stdio, the npm package @dynomapper/mcp-server)
# ---------------------------------------------------------------------------
DYNOMAPPER_API_URL=https://api.dynomapper.com
DYNOMAPPER_API_KEY=your_personal_access_token_here

# ---------------------------------------------------------------------------
# Hosted server (packages/http, the container image)
#
# Every request carries its own Authorization header, so the key above is
# ignored here; the server warns at startup when it is set. See HOSTING.md for
# what each MCP_* setting does.
# ---------------------------------------------------------------------------
# MCP_PORT=3000
# MCP_HOST=127.0.0.1
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com
# MCP_TRUST_PROXY=true
# MCP_RATE_LIMIT=60
# MCP_RATE_BURST=20
# MCP_MAX_BODY_BYTES=262144
# MCP_MAX_CONCURRENCY=100
# MCP_REQUEST_TIMEOUT_MS=25000
# MCP_JSON_RESPONSES=true
