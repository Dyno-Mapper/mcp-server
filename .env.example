# ---------------------------------------------------------------------------
# stdio server (packages/stdio, the npm package @dynomapper/mcp-server)
# ---------------------------------------------------------------------------
DYNOMAPPER_API_URL=https://api.dynomapper.com
DYNOMAPPER_API_KEY=your_personal_access_token_here

# ---------------------------------------------------------------------------
# Hosted server (packages/http, the container image)
#
# Every request carries its own Authorization header, so the key above is
# ignored here; the server warns at startup when it is set. See HOSTING.md for
# what each MCP_* setting does.
# ---------------------------------------------------------------------------
# MCP_PORT=3000
# MCP_HOST=127.0.0.1
# MCP_ALLOWED_HOSTS=mcp.example.com
# MCP_ALLOWED_ORIGINS=https://app.example.com
# MCP_TRUST_PROXY=true
# MCP_RATE_LIMIT=60
# MCP_RATE_BURST=20
# A JSON-RPC tool call is kilobytes; files no longer travel in a body.
# MCP_MAX_BODY_BYTES=4194304
# MCP_MAX_CONCURRENCY=100
# MCP_MAX_UPLOAD_CONCURRENCY=2
# MCP_REQUEST_TIMEOUT_MS=25000
# MCP_JSON_RESPONSES=true
# The origin this deployment answers at. Unset, the URLs advertised to MCP
# clients are derived from each request's Host, which is only as right as the
# forwarded headers. Set it in a deployment: it is what the RFC 9728 document
# calls the resource.
# MCP_PUBLIC_URL=https://mcp.dynomapper.com
# Issuer of the authorization server that issues tokens for this endpoint. It
# must match that server's own issuer exactly.
# MCP_AUTHORIZATION_SERVER=https://api.dynomapper.com

# Uploads. The secret is what seals an upload URL; it is required for uploads
# and nothing else, so a deployment without it still serves every other tool.
# Use at least 32 characters, and rotate it if it leaks: rotating invalidates
# every upload URL already handed out.
# MCP_UPLOAD_SECRET=replace_with_a_passphrase_of_at_least_32_characters
# How long an upload URL stays valid, in milliseconds.
# MCP_UPLOAD_TICKET_TTL_MS=600000
# Budget for the upstream leg of one upload, and for a leg that has moved
# nothing at all.
# MCP_UPLOAD_TIMEOUT_MS=300000
# MCP_UPLOAD_IDLE_TIMEOUT_MS=60000
