{
  "name": "@dynomapper/mcp-server",
  "version": "0.1.3",
  "description": "DYNO Mapper MCP Server for AI agents and Claude integrations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dynomapper-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.13.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mime-types": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^20.19.37",
    "prettier": "3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
