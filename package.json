{
  "name": "@dynomapper/mcp-server",
  "version": "0.1.8",
  "description": "DYNO Mapper MCP Server for AI agents and Claude integrations",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "dynomapper",
    "accessibility",
    "sitemap",
    "seo-audit",
    "content-audit"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dynomapper-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mime-types": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.19.2",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
