{
  "name": "dynomapper-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "The DYNO Mapper MCP servers: stdio for npm, Streamable HTTP for containers.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @dynomapper/mcp-server",
    "dev": "npm run dev -w @dynomapper/mcp-server",
    "test": "npm run test -ws --if-present",
    "check": "npm run check -ws --if-present",
    "format": "vp fmt .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  }
}
